# Dockerfile for UET Python Agent (Semantic Engine + Executive Router)
FROM python:3.12-slim

WORKDIR /app

# Install dependencies
COPY uet_agents/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy agent source
COPY uet_agents ./uet_agents

# Expose agent API port
EXPOSE 8001

CMD ["python", "-m", "uet_agents.api_server"]
