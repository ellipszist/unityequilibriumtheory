// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. IDENTITY & AUTHENTICATION
// ==========================================

model User {
  id           String   @id @default(uuid())
  name         String?
  email        String   @unique
  passwordHash String?
  image        String?
  reputation   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Profile fields
  displayName String?
  bio         String? @db.Text
  avatarUrl   String?
  institution String?
  website     String?

  // Relations
  wallet          Wallet?
  posts           Post[]
  comments        Comment[]
  ownedProjects   Project[]         @relation("ProjectOwner")
  tasksAssigned   Task[]            @relation("TaskAssignee")
  computeLogs     ComputeLog[]
  followers       Follow[]          @relation("Following")
  following       Follow[]          @relation("Followers")
  media           Media[]
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  workspaces      WorkspaceMember[]
  documents       Document[]
  creditBalance   CreditBalance?
  subscription    Subscription?
  chatMessages    ChatMessage[]
}

// ==========================================
// 2. WALLET & FINANCE (BRIDGE TO RUST CHAIN)
// ==========================================

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address   String   @unique // Uet-Cash blockchain address
  publicKey String? // For signing transactions
  balance   Float    @default(0) // Cached balance (syncs with Rust chain)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactionsSent     Transaction[] @relation("TxSender")
  transactionsReceived Transaction[] @relation("TxReceiver")
}

model Transaction {
  id           String   @id @default(uuid())
  txHash       String?  @unique // Hash from the Rust blockchain
  fromWalletId String? // Null if it's a mining reward (system tx)
  toWalletId   String
  amount       Float
  type         TxType
  status       TxStatus @default(PENDING)
  createdAt    DateTime @default(now())

  fromWallet Wallet? @relation("TxSender", fields: [fromWalletId], references: [id])
  toWallet   Wallet  @relation("TxReceiver", fields: [toWalletId], references: [id])
}

enum TxType {
  MINING_REWARD
  TRANSFER
  BOUNTY_PAYOUT
  STAKING
}

enum TxStatus {
  PENDING
  CONFIRMED
  FAILED
}

// ==========================================
// 3. SOCIAL & KNOWLEDGE HUB
// ==========================================

model Post {
  id         String   @id @default(uuid())
  authorId   String
  title      String
  content    String   @db.Text // Supports Markdown & LaTeX
  upvotes    Int      @default(0)
  isVerified Boolean  @default(false) // PoUW verified insight
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  tags     Tag[]
  media    Media[]
  votes    Vote[]
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String   @db.Text
  upvotes   Int      @default(0)
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Tag {
  id    String @id @default(uuid())
  name  String @unique
  posts Post[]
}

// ==========================================
// 4. COLLABORATION & PROJECTS
// ==========================================

model Project {
  id          String        @id @default(uuid())
  ownerId     String
  workspaceId String?
  name        String
  description String        @db.Text
  status      ProjectStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner     User           @relation("ProjectOwner", fields: [ownerId], references: [id])
  workspace Workspace?     @relation(fields: [workspaceId], references: [id])
  tasks     Task[]
  wallet    ProjectWallet?
}

model ProjectWallet {
  id        String   @id @default(uuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  address   String   @unique // Uet-Cash blockchain address
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id           String     @id @default(uuid())
  projectId    String
  title        String
  description  String     @db.Text
  bountyAmount Float      @default(0) // Uet-Cash reward for completing
  status       TaskStatus @default(TODO)
  assigneeId   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

// ==========================================
// 5. MINING & COMPUTE LOGS
// ==========================================

model ComputeLog {
  id           String   @id @default(uuid())
  userId       String
  rustTaskId   String // ID of the task from uet_core
  nonce        BigInt
  resultHash   String
  difficulty   Int
  rewardEarned Float    @default(0)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 6. SOCIAL GRAPH
// ==========================================

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Vote {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  value     Int // +1 or -1
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Media {
  id        String    @id @default(uuid())
  postId    String?
  userId    String
  url       String
  type      MediaType
  filename  String
  size      Int       @default(0)
  createdAt DateTime  @default(now())

  post Post? @relation(fields: [postId], references: [id], onDelete: SetNull)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

// ==========================================
// 7. WORKSPACES & COLLABORATION
// ==========================================

model Workspace {
  id           String   @id @default(uuid())
  name         String
  description  String?  @db.Text
  avatarUrl    String?
  ownerId      String
  rocketChatId String?  @unique
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner     User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members   WorkspaceMember[]
  documents Document[]
  projects  Project[]
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

model Document {
  id          String   @id @default(uuid())
  workspaceId String
  title       String
  yjsDocId    String   @unique
  content     Bytes? // Yjs binary state
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])
}

// ==========================================
// 8. CREDITS & SUBSCRIPTION
// ==========================================

model CreditBalance {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0)
  lifetime  Int      @default(0)
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
}

model CreditTransaction {
  id              String       @id @default(uuid())
  creditBalanceId String
  amount          Int
  type            CreditTxType
  description     String?
  referenceId     String?
  createdAt       DateTime     @default(now())

  creditBalance CreditBalance @relation(fields: [creditBalanceId], references: [id], onDelete: Cascade)
}

enum CreditTxType {
  PURCHASE
  SUBSCRIPTION
  UET_EXCHANGE
  AI_USAGE
  BONUS
  REFUND
  ADMIN_ADJUSTMENT
}

model Subscription {
  id                 String    @id @default(uuid())
  userId             String    @unique
  stripeCustomerId   String?   @unique
  stripeSubId        String?   @unique
  plan               PlanTier  @default(FREE)
  status             SubStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

// ==========================================
// 9. CHAT & MESSAGING
// ==========================================

model ChatChannel {
  id          String      @id @default(uuid())
  name        String
  type        ChannelType
  projectId   String? // Only if type is TOPIC
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  messages ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(uuid())
  channelId String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

enum ChannelType {
  COMMUNITY
  TOPIC
  DIRECT_MESSAGE
}
